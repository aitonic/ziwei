{
  "$schema": "app/node_modules/wrangler/config-schema.json",
  "name": "ziwei",
  "main": "app/worker.js",
  "compatibility_date": "2026-05-05",
  "build": {
    "command": "npm ci && npm run build",
    "cwd": "app"
  },
  "assets": {
    "directory": "app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "AUTH_PASSWORD": "",
    "LLM_API_KEY": "",
    "LLM_PROVIDER": "custom",
    "LLM_MODEL": "gpt-5.5",
    "LLM_BASE_URL": "https://cpa.aitonic.me/v1",
    "LLM_ENABLE_THINKING": "true",
    "LLM_ENABLE_WEB_SEARCH": "false"
  },
  "observability": {
    "enabled": true
  }
}
